{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crux Hub",
  "version": "0.1.0",
  "identifier": "dev.crux.hub",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Crux Hub",
    "longDescription": "A window and tray icon for the Crux hub running on this PC.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
